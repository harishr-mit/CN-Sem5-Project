{
  "//": "Type-check config for the Node side (shared, server, emulator, tests). Run: npm run typecheck",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@nobu/shared/*": ["shared/src/*"] }
  },
  "include": ["shared/src", "server/src", "emulator/src", "tests", "client/src/net/NetClient.ts"]
}
